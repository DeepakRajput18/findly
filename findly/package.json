{
  "name": "findly",
  "version": "1.0.0",
  "description": "Lost and Found Item Management System",
  "main": "index.js",
  "scripts": {
    "build": "cd frontend && npm ci && npm run build",
    "start": "cd backend && npm install --production && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start-findly": "node scripts/start-findly.js",
    "kill-ports": "node scripts/kill-ports.js",
    "test-mongodb": "node scripts/test-mongodb.js"
  },
  "keywords": [
    "lost",
    "found",
    "items",
    "management"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0 <25.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "mongoose": "^8.19.2"
  }
}